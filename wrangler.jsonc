{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "loh-zuprimillo-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "loh-zuprimillo-db",
      "database_id": "77123900-bb35-47d8-b58b-23d2ed7551bf",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "loh-zuprimillo-media",
    },
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "SESSION_TTL_DAYS": "30",
  },
  "secrets": {
    "required": ["BOOTSTRAP_TOKEN"],
  },
}
